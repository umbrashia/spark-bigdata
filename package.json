{
  "name": "spark-bigdata",
  "version": "1.0.0",
  "description": "PySpark-style TypeScript facade over Apache Spark via node4j",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umbrashia/spark-bigdata.git"
  },
