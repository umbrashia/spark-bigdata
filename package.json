  "bugs": {
    "url": "https://github.com/umbrashia/spark-bigdata/issues"
  },
  "homepage": "https://github.com/umbrashia/spark-bigdata#readme",
  "keywords": [
    "spark",
    "pyspark",
    "node4j",
    "big-data",
    "typescript"
  ],
  "dependencies": {
    "node4j": "^0.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
